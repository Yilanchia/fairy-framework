{
  "name": "@fairy/app",
  "version": "0.0.1",
  "description": "Fairy's own page: a small PWA the host serves at /fairy/app, so the owner can pair a device and talk to her from anywhere on their private network. No framework, no build step for the client.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "web"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && node --test \"dist/*.test.js\""
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "dependencies": {
    "@fairy/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.19.2",
    "typescript": "5.8.3"
  }
}
