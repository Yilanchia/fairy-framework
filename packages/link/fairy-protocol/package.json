{
  "name": "@fairy/protocol",
  "version": "0.0.1",
  "description": "The wire between Fairy's host and her devices: versioned JSON messages, and the only validators both sides check them with. Pure TypeScript, no DeepSeek Harness imports.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && node --test \"dist/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "5.8.3"
  }
}
