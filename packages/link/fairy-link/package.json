{
  "name": "@fairy/link",
  "version": "0.0.1",
  "description": "Fairy's channel to her devices: pairing, device tokens, one WebSocket carrying the owner's words into a DeepSeek Harness session, and confirmations back out.",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && node --test \"dist/*.test.js\""
  },
  "engines": {
    "dsh": "0.2.1-rc.5"
  },
  "dependencies": {
    "@fairy/core": "workspace:*",
    "@fairy/protocol": "workspace:*"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "~4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.5",
    "@deepseek-ai/dsh-host-webserver": "0.2.1-rc.5",
    "@deepseek-ai/dsh-session": "0.2.1-rc.5",
    "@deepseek-ai/dsh-user-questions": "0.2.1-rc.5",
    "@deepseek-ai/schemastery": "3.18.5",
    "@types/node": "24.19.2",
    "typescript": "5.8.3"
  }
}
