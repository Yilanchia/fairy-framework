# Copy to .env (gitignored). Read only by Fairy's own DSH, never by your other DSH installs.
# Alternatively, add the key in Fairy's Web UI: Settings → Models.
DEEPSEEK_API_KEY=

# Optional. Lets her recall by meaning, not only by words ("我对象在哪个城市" finds "女朋友在杭州").
# A key from https://cloud.siliconflow.cn ; the default model BAAI/bge-m3 is free there. What she
# remembers is sent to SiliconFlow to be embedded; leave this empty to keep everything local.
SILICONFLOW_API_KEY=

# Where the owner reaches her page, so `pnpm pair` prints the address he actually uses.
# On a plain local host this can stay empty; the launcher then says http://127.0.0.1:3090.
FAIRY_PUBLIC_URL=
