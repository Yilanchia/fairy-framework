{
  "name": "fairy",
  "private": true,
  "license": "Apache-2.0",
  "description": "Fairy: a butler agent built as DeepSeek Harness plugins, with an Isla life kernel as her self.",
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b --noEmit",
    "test": "tsc -b && node --test \"packages/*/*/dist/*.test.js\"",
    "setup:profile": "tsc -b && node scripts/fairy.mjs setup",
    "dump": "node scripts/fairy.mjs dump",
    "fairy": "tsc -b && node scripts/fairy.mjs web",
    "smoke": "tsc -b && node scripts/fairy.mjs smoke",
    "memory": "tsc -b && node scripts/fairy.mjs memory",
    "doctor": "tsc -b && node scripts/fairy.mjs doctor",
    "pair": "node scripts/fairy.mjs pair",
    "devices": "node scripts/fairy.mjs devices",
    "revoke": "node scripts/fairy.mjs revoke"
  },
  "devDependencies": {
    "@deepseek-ai/dsh": "0.2.1-rc.5",
    "@types/node": "24.19.2",
    "playwright": "^1.65.1",
    "typescript": "5.8.3"
  }
}
